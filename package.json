{
  "name": "negocia-caixa",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "lint": "ng lint",
    "lint:a11y": "eslint \"src/app/**/*.html\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:a11y": "ng test --watch=false --browsers=ChromeHeadless --include=src/**/*.a11y.spec.ts",
    "test:coverage": "ng test --watch=false --code-coverage",
    "validate:a11y": "npm run lint:a11y && npm run test:a11y",
    "mock-api": "json-server --watch src/app/core/mocks/db.json --port 3000"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.0",
    "@angular/cdk": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@ngrx/effects": "^19.0.0",
    "@ngrx/entity": "^19.0.0",
    "@ngrx/store": "^19.0.0",
    "@ngrx/store-devtools": "^19.0.0",
    "keycloak-angular": "^19.0.2",
    "keycloak-js": "^26.0.0",
    "ngx-mask": "^19.0.7",
    "or": "^0.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.21",
    "@angular/cli": "^19.2.21",
    "@angular/compiler-cli": "^19.2.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "21.0.1",
    "axe-core": "^4.11.4",
    "eslint": "^9.39.1",
    "jasmine-core": "~5.6.0",
    "jasmine-marbles": "^0.9.2",
    "json-server": "^0.17.4",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.46.4"
  }
}
